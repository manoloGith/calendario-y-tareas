<?xml version="1.0" encoding="utf-8"?>
<!-- Widget «Calendario» -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_bg_light" android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="12dp">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingBottom="4dp" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:textSize="14sp" />
        <LinearLayout android:id="@+id/weekdays" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" />
        <LinearLayout android:id="@+id/grid" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="vertical" />
    </LinearLayout>
</FrameLayout>
